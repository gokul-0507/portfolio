---
// Base.astro
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../data/site';
import '../styles/tokens.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = `${siteData.name} | Computer Science and Design Student`,
  description = 'Personal portfolio of Gokul J., an undergraduate in Computer Science and Design at SRM Easwari Engineering College focusing on software development, AI/ML, and sensing systems.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteData.siteUrl);
const ogImageURL = new URL(image, siteData.siteUrl);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteData.name,
  jobTitle: 'Computer Science and Design Student',
  worksFor: {
    '@type': 'EducationalOrganization',
    name: siteData.college,
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: siteData.college,
  },
  url: siteData.siteUrl,
  sameAs: [siteData.github, siteData.linkedin],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon Set -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0F14" id="meta-theme-color" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:site_name" content={siteData.name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL.href} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <!-- Anti-FOUC Theme Initialization Script -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = 'dark';
          if (saved) {
            theme = saved;
          } else if (
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: light)').matches
          ) {
            theme = 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.getElementById('meta-theme-color');
          if (meta) {
            meta.setAttribute('content', theme === 'dark' ? '#0B0F14' : '#F7F8FA');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Native View Transitions -->
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-text selection:bg-accent/30 selection:text-text">
    <!-- Accessible Skip to Main Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-bg focus:font-mono focus:font-semibold focus:rounded-item focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Header Landmark -->
    <Header />

    <!-- Main Landmark -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer Landmark -->
    <Footer />
  </body>
</html>
