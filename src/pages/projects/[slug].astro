---
// [slug].astro
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SatQueryDiagram from '../../components/diagrams/SatQueryDiagram.astro';
import EchoGridDiagram from '../../components/diagrams/EchoGridDiagram.astro';
import { siteData } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, index, category, status, statusType, summary, topics, architectureLabel, repoUrl } =
  project.data;
---

<Base title={`${title} — Case Study | ${siteData.name}`} description={summary} type="article">
  <article class="py-12 sm:py-20">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb & Back Action -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 text-xs font-mono text-muted hover:text-accent transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent py-1.5 px-2 rounded-item border border-border bg-surface"
        >
          <span aria-hidden="true">←</span>
          <span>Back to all projects</span>
        </a>
      </nav>

      <!-- Case Study Header -->
      <header class="border-b border-border pb-10 mb-12 space-y-6">
        <!-- Mono Label & Status Badge -->
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="inline-flex items-center gap-2 text-xs font-mono tracking-wider text-muted uppercase">
            <span class="text-accent font-semibold">{index}</span>
            <span class="text-border-subtle">/</span>
            <span>{category}</span>
          </div>

          <!-- Status Badge (Icon + Text) -->
          <div
            class:list={[
              'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium border',
              statusType === 'proposal'
                ? 'bg-accent-2/10 text-accent-2 border-accent-2/30'
                : 'bg-accent/10 text-accent border-accent/30',
            ]}
          >
            {statusType === 'proposal' ? (
              <svg
                class="w-3.5 h-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                <polyline points="14 2 14 8 20 8" />
              </svg>
            ) : (
              <svg
                class="w-3.5 h-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="3" />
                <path d="M4.93 4.93a10 10 0 0 0 0 14.14" />
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
              </svg>
            )}
            <span>{status}</span>
          </div>
        </div>

        <!-- Primary Page Heading (Single H1) -->
        <h1 class="type-h1 text-text font-display font-bold tracking-tight">{title}</h1>

        <!-- One or Two Sentence Factual Summary -->
        <p class="type-body text-muted text-lg sm:text-xl max-w-3xl leading-relaxed">{summary}</p>

        <!-- Topic Chips -->
        <div class="flex flex-wrap gap-2 pt-2" aria-label="Project classifications">
          {topics.map((topic) => (
            <span class="px-3 py-1 rounded-chip text-xs font-mono bg-surface-subtle text-muted border border-border">
              {topic}
            </span>
          ))}
        </div>
      </header>

      <!-- Architecture Diagram Highlight Box -->
      <section
        class="mb-14 rounded-card border border-border bg-surface p-6 sm:p-8 space-y-4"
        aria-label="System Architecture Visual"
      >
        <div class="flex items-center justify-between border-b border-border pb-3">
          <span class="text-xs font-mono uppercase tracking-wider text-accent font-semibold">
            FIG {index}.0 · ARCHITECTURE TOPOLOGY
          </span>
          <span class="text-xs font-mono text-muted">{architectureLabel}</span>
        </div>

        <div class="pt-2">
          {project.id.includes('satquery-ai') && <SatQueryDiagram />}
          {project.id.includes('echogrid') && <EchoGridDiagram />}
        </div>
      </section>

      <!-- Rendered Markdown Body Content -->
      <div class="prose-portfolio max-w-3xl">
        <Content />
      </div>

      <!-- Case Study Footer & Links -->
      <footer class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 text-sm font-mono text-muted hover:text-accent transition-colors"
        >
          <span>← Back to all projects</span>
        </a>

        {repoUrl ? (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-item bg-accent text-bg font-mono text-xs font-semibold hover:opacity-90 transition-opacity"
          >
            <span>View Repository</span>
            <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="text-xs font-mono text-muted italic">
            <!-- TODO(gokul): add repository URL when public -->
            Public repository URL pending verification
          </span>
        )}
      </footer>
    </div>
  </article>
</Base>

<style is:global>
  .prose-portfolio h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw + 0.5rem, 2rem);
    font-weight: 700;
    color: var(--text);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .prose-portfolio h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose-portfolio p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .prose-portfolio ul,
  .prose-portfolio ol {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--muted);
  }

  .prose-portfolio li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .prose-portfolio li strong {
    color: var(--text);
  }

  .prose-portfolio code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--surface-subtle);
    border: 1px solid var(--border);
    padding: 0.15em 0.35em;
    border-radius: 4px;
    color: var(--accent);
  }
</style>
