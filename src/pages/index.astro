  <!-- 4. Projects -->
  <ProjectsSection />

  <!-- 5. Skills -->
  <Skills />

  <!-- 6. Interests -->
  <Interests />

  <!-- 7. Education -->
  <Education />

  <!-- 8. Contact -->
  <Contact />
</Base>
