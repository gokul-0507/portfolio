---
// Footer.astro
import { siteData } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[var(--card-border)] bg-[var(--card-bg)] mt-auto transition-colors duration-200">
  <div class="max-w-5xl mx-auto px-6 sm:px-12 lg:px-16 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <!-- Col 1: Bio & Positioning -->
      <div class="md:col-span-6 space-y-3">
        <div class="inline-flex items-center gap-2 font-display font-bold text-lg text-[var(--white)]">
          <span class="w-2 h-2 rounded-full bg-[var(--sec)] inline-block"></span>
          <span>{siteData.name}</span>
        </div>
        <p class="text-sm text-[var(--white-icon)] max-w-sm">
          {siteData.degree} at {siteData.college} ({siteData.batch}). Focused on software
          development, AI/ML, and sensing systems.
        </p>
        <div class="pt-2 text-xs font-mono text-[var(--white-icon)]">
          <span>Theme: Systems that sense and reason.</span>
        </div>
      </div>

      <!-- Col 2: Navigation & Anchors -->
      <div class="md:col-span-3 space-y-2">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--white-icon)] font-semibold block">Navigation</span>
        <ul class="space-y-1.5 text-sm font-mono">
          <li>
            <a href="/#about" class="text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors">
              01 / About
            </a>
          </li>
          <li>
            <a href="/#experience" class="text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors">
              02 / Experience
            </a>
          </li>
          <li>
            <a href="/#projects" class="text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors">
              03 / Projects
            </a>
          </li>
          <li>
            <a href="/#skills" class="text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors">
              04 / Skills
            </a>
          </li>
          <li>
            <a href="/#interests" class="text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors">
              05 / Interests
            </a>
          </li>
          <li>
            <a href="/#education" class="text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors">
              06 / Education
            </a>
          </li>
          <li>
            <a href="/#contact" class="text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors">
              07 / Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: External Profiles -->
      <div class="md:col-span-3 space-y-2">
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--white-icon)] font-semibold block">Profiles</span>
        <ul class="space-y-1.5 text-sm font-mono">
          <li>
            <a
              href={siteData.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors"
            >
              <span>GitHub</span>
              <span aria-hidden="true" class="text-xs">
                ↗
              </span>
            </a>
          </li>
          <li>
            <a
              href={siteData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors"
            >
              <span>LinkedIn</span>
              <span aria-hidden="true" class="text-xs">
                ↗
              </span>
            </a>
          </li>
          <li>
            <a
              href="https://mail.google.com/mail/?view=cm&fs=1&to=gokuljayakumar947@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors"
            >
              <span>Email</span>
              <span aria-hidden="true" class="text-xs">
                ↗
              </span>
            </a>
          </li>
          <li>
            <a
              href="/#top"
              class="inline-flex items-center gap-1.5 text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors mt-2"
            >
              <span>Back to top ↑</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-[var(--card-border)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[var(--white-icon)]">
      <p>
        © {currentYear} {siteData.name}. No trackers. Zero font CDNs.
      </p>
      <p class="text-xs text-[var(--white-icon)]">Self-hosted typography · Semantic HTML · WCAG 2.2 AA</p>
    </div>
  </div>
</footer>
