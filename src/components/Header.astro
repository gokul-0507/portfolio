---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';
import { siteData } from '../data/site';

const navLinks = [
  {
    href: '/#top',
    label: 'Home',
    id: 'top',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"/></svg>`,
  },
  {
    href: '/#about',
    label: 'About',
    id: 'about',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>`,
  },
  {
    href: '/#experience',
    label: 'Experience',
    id: 'experience',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20 6h-2.18c.07-.44.18-.88.18-1.33C18 2.99 16.02 1 13.5 1c-1.18 0-2.23.49-2.99 1.27L10 2.9l-.51-.63C8.73 1.49 7.68 1 6.5 1 3.98 1 2 2.99 2 5.5c0 .45.11.89.18 1.33H0v13c0 1.1.9 2 2 2h20c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7.5-3c.83 0 1.5.67 1.5 1.5S13.33 6 12.5 6H11V4.5c0-.83.67-1.5 1.5-1.5zm-6 0c.83 0 1.5.67 1.5 1.5V6H6.5C5.67 6 5 5.33 5 4.5S5.67 3 6.5 3zM20 19H4v-9h16v9z"/></svg>`,
  },
  {
    href: '/#projects',
    label: 'Projects',
    id: 'projects',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"/></svg>`,
  },
  {
    href: '/#skills',
    label: 'Skills',
    id: 'skills',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>`,
  },
  {
    href: '/#contact',
    label: 'Contact',
    id: 'contact',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"/></svg>`,
  },
];
---

<!-- Floating Header Area -->
<header class="fixed top-0 md:top-6 left-0 right-0 z-[100] pointer-events-none flex justify-center px-4 sm:px-6">
  <div class="pointer-events-auto flex items-center justify-center gap-3 sm:gap-4 max-w-5xl w-full">
    <!-- Main Floating Capsule -->
    <nav
      id="main-nav"
      aria-label="Main Navigation"
      class="border border-[var(--white-icon-tr)] backdrop-blur-xl transition-all duration-300 ease-in-out bg-[var(--component-bg)] md:rounded-full rounded-2xl shadow-lg px-4 sm:px-6 py-2.5 flex items-center justify-between gap-4 sm:gap-8 flex-1 max-w-fit"
    >
      <!-- Brand Logo / Name (nowrap & vertically centered) -->
      <a
        href="/#top"
        class="inline-flex items-center gap-2 text-[var(--white)] font-display font-semibold text-base whitespace-nowrap shrink-0 hover:text-[var(--sec)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)] py-1"
        aria-label={`Home — ${siteData.name}`}
      >
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--sec)] shrink-0 inline-block shadow-sm" aria-hidden="true"></span>
        <span class="whitespace-nowrap font-medium tracking-tight">{siteData.name}</span>
      </a>

      <!-- Desktop Navigation Links -->
      <ul class="hidden md:flex items-center gap-1 lg:gap-1.5 shrink-0">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-id={link.id}
                class="nav-desktop-link relative inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-sans font-medium text-[var(--white-icon)] hover:text-[var(--white)] rounded-full transition-colors duration-150 whitespace-nowrap focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)]"
              >
                <span
                  class="nav-indicator w-1.5 h-1.5 rounded-full bg-[#A9FF5B] scale-0 opacity-0 transition-all duration-200 shrink-0 inline-block"
                  aria-hidden="true"
                />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Theme Toggle (Cleanly positioned beside the capsule, aligned along horizontal axis) -->
    <div class="hidden md:flex items-center shrink-0">
      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile Bottom Bar Navigation -->
  <nav
    id="mobile-nav"
    aria-label="Mobile Navigation"
    class="md:hidden fixed bottom-0 left-0 right-0 z-[100] border-t border-[var(--white-icon-tr)] bg-[var(--component-bg)] backdrop-blur-xl px-2 py-1.5 pointer-events-auto shadow-2xl"
  >
    <ul class="flex w-full justify-around items-center">
      {
        navLinks.map((link) => (
          <li class="flex-1">
            <a
              href={link.href}
              data-nav-id={link.id}
              class="nav-mobile-link flex flex-col items-center gap-0.5 text-[var(--white-icon)] hover:text-[var(--white)] transition-colors py-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)]"
              aria-label={link.label}
            >
              <span class="flex items-center justify-center w-6 h-6">
                <Fragment set:html={link.icon} />
              </span>
              <span class="text-[10px] font-sans whitespace-nowrap">{link.label}</span>
            </a>
          </li>
        ))
      }
      <li class="flex-1 flex flex-col items-center justify-center py-1">
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<style>
  /* Active nav state */
  nav a.active .nav-indicator {
    transform: scale(1) !important;
    opacity: 1 !important;
  }

  nav a.active {
    color: var(--white) !important;
  }
</style>

<script>
  function setupNav() {
    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-desktop-link');
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-mobile-link');
    const sections = document.querySelectorAll<HTMLElement>('section[id]');

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const currentId = entry.target.getAttribute('id');
              [...desktopLinks, ...mobileLinks].forEach((link) => {
                const targetId = link.getAttribute('data-nav-id');
                if (targetId === currentId) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });
            }
          });
        },
        { rootMargin: '-20% 0px -70% 0px' },
      );
      sections.forEach((s) => observer.observe(s));
    }
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
