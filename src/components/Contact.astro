---
// Contact.astro
import { siteData } from '../data/site';

// Obfuscate email parts to deter scrapers
const emailUser = 'gokuljayakumar947';
const emailDomain = 'gmail.com';
---

<section id="contact" class="py-16 sm:py-24 scroll-mt-20">
  <div class="max-w-5xl mx-auto px-9 sm:px-16 lg:px-20">
    <!-- Section heading -->
    <div class="mb-10 sm:mb-14">
      <p class="text-base text-[var(--sec)] shiny-sec mb-2">Let's talk</p>
      <h2 class="text-4xl md:text-5xl font-medium text-[var(--white)] leading-tight">Contact</h2>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
      <!-- Left: description + location + direct channels -->
      <div class="space-y-6 text-[var(--white-icon)]">
        <p class="text-base leading-relaxed">
          Have an idea or want to collaborate? Feel free to reach out — I'm always open to technical
          discussions and student opportunities.
        </p>

        <div class="flex items-center gap-2 text-sm">
          <span>📍 Location:</span>
          <span class="text-[var(--white)]">Chennai, India</span>
        </div>

        <!-- Direct email reveal -->
        <div class="p-5 rounded-2xl border border-[var(--card-border)] bg-[var(--card-bg)] space-y-3 shadow-sm">
          <p class="text-xs font-mono text-[var(--white-icon)] uppercase tracking-wider font-semibold">Direct Email</p>
          <span
            id="email-display"
            class="font-mono text-sm sm:text-base text-[var(--white)] select-all block font-medium"
            data-u={emailUser}
            data-d={emailDomain}
          >
            [Click to reveal]
          </span>
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <a
              id="mailto-link"
              href="https://mail.google.com/mail/?view=cm&fs=1&to=gokuljayakumar947@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-mono font-medium text-[var(--white)] border border-[var(--btn-border)] bg-[var(--btn-bg)] rounded-xl hover:bg-[var(--btn-hover-bg)] hover:text-[var(--sec)] hover:border-[var(--sec)] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)]"
            >
              Open in Gmail ↗
            </a>
            <button
              id="copy-email-button"
              type="button"
              data-u={emailUser}
              data-d={emailDomain}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-mono font-medium text-[var(--white)] border border-[var(--btn-border)] bg-[var(--btn-bg)] rounded-xl hover:bg-[var(--btn-hover-bg)] hover:text-[var(--sec)] hover:border-[var(--sec)] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)]"
              aria-label="Copy email address to clipboard"
            >
              <span id="copy-text">Copy email</span>
            </button>
          </div>
        </div>

        <!-- External profiles -->
        <div class="flex items-center gap-4 pt-2">
          <a
            href={siteData.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-mono text-[var(--white-icon)] hover:text-[var(--white)] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)]"
          >
            GitHub ↗
          </a>
          <a
            href={siteData.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-mono text-[var(--white-icon)] hover:text-[var(--white)] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)]"
          >
            LinkedIn ↗
          </a>
        </div>

        <!-- Screen reader live region -->
        <div id="copy-status" class="sr-only" aria-live="polite"></div>
      </div>

      <!-- Right: contact form -->
      <div>
        <form
          id="contact-form"
          class="flex flex-col gap-4"
        >
          <div>
            <label for="contact-name" class="sr-only">Name</label>
            <input
              type="text"
              id="contact-name"
              name="from_name"
              placeholder="Your Name"
              required
              class="w-full px-4 py-3 bg-[var(--input-bg)] text-[var(--white)] border border-[var(--input-border)] rounded-xl placeholder-[var(--input-placeholder)] focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition shadow-sm"
            />
          </div>

          <div>
            <label for="contact-email" class="sr-only">Email</label>
            <input
              type="email"
              id="contact-email"
              name="reply_to"
              placeholder="Your Email Address"
              required
              class="w-full px-4 py-3 bg-[var(--input-bg)] text-[var(--white)] border border-[var(--input-border)] rounded-xl placeholder-[var(--input-placeholder)] focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition shadow-sm"
            />
          </div>

          <div>
            <label for="contact-message" class="sr-only">Message</label>
            <textarea
              id="contact-message"
              name="message"
              placeholder="Your Message..."
              rows="6"
              required
              class="w-full px-4 py-3 bg-[var(--input-bg)] text-[var(--white)] border border-[var(--input-border)] rounded-xl placeholder-[var(--input-placeholder)] focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none transition shadow-sm"
            ></textarea>
          </div>

          <button
            type="submit"
            id="send-button"
            class="px-5 py-3.5 bg-[var(--sec)] text-white font-sans font-semibold rounded-xl hover:opacity-90 active:scale-[0.99] transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)] shadow-md flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Send Message</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>

        <!-- Success message -->
        <div
          id="form-message"
          class="hidden flex-col items-center justify-center p-6 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-center gap-2 mt-4"
        >
          <span class="text-2xl">✅</span>
          <p class="font-semibold text-lg">Message Prepared & Sent!</p>
          <p class="text-xs text-[var(--white-icon)]">Opening your email client to deliver to {siteData.email}.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupContact() {
    const display = document.getElementById('email-display');
    const mailto = document.getElementById('mailto-link') as HTMLAnchorElement | null;
    const copyBtn = document.getElementById('copy-email-button');
    const copyText = document.getElementById('copy-text');
    const statusRegion = document.getElementById('copy-status');
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const formMessage = document.getElementById('form-message');

    if (!display || !copyBtn) return;

    const user = display.getAttribute('data-u') || '';
    const domain = display.getAttribute('data-d') || '';
    const email = `${user}@${domain}`;

    display.textContent = email;

    if (mailto) {
      mailto.href = `mailto:${email}`;
    }

    copyBtn.onclick = async () => {
      try {
        await navigator.clipboard.writeText(email);
        if (copyText) copyText.textContent = 'Copied!';
        if (statusRegion) statusRegion.textContent = 'Email address copied to clipboard';

        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy email';
          if (statusRegion) statusRegion.textContent = '';
        }, 3000);
      } catch {
        if (copyText) copyText.textContent = email;
      }
    };

    // Form submission: Reliable direct mailto delivery with visual feedback
    if (form && formMessage) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
        const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
        const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

        const name = nameInput?.value.trim() || 'Visitor';
        const senderEmail = emailInput?.value.trim() || '';
        const message = messageInput?.value.trim() || '';

        const subject = encodeURIComponent(`Portfolio Inquiry from ${name}`);
        const body = encodeURIComponent(
          `Hi Gokul,\n\nName: ${name}\nEmail: ${senderEmail}\n\nMessage:\n${message}\n`
        );

        // Open user's default email client pre-filled
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

        // Show friendly confirmation UI
        form.reset();
        form.style.display = 'none';
        formMessage.classList.remove('hidden');
        formMessage.classList.add('flex');
      });
    }
  }

  setupContact();
  document.addEventListener('astro:after-swap', setupContact);
</script>
