---
// About.astro
---

<section id="about" class="py-16 sm:py-24 border-b border-[var(--white-icon-tr)] scroll-mt-20">
  <div class="max-w-5xl mx-auto px-9 sm:px-16 lg:px-20">
    <!-- Section heading -->
    <div class="mb-10 sm:mb-14">
      <p class="text-base text-[var(--sec)] shiny-sec mb-2">Who I am</p>
      <h2 class="text-4xl md:text-5xl font-medium text-[var(--white)] leading-tight">About Me</h2>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
      <!-- Left: bio paragraphs -->
      <div class="lg:col-span-8 space-y-5 text-[var(--white-icon)] text-base sm:text-lg leading-relaxed">
        <p>
          I'm an undergraduate student at SRM Easwari Engineering College in Chennai, studying
          Computer Science and Design (2025–2029).
        </p>
        <p>
          I spend most of my time working in Python and Java, practicing data structures, and
          learning how computer vision and autonomous agents interpret real-world inputs.
        </p>
      </div>

      <!-- Right: Key Details -->
      <div class="lg:col-span-4 border-t lg:border-t-0 lg:border-l border-[var(--card-border)] pt-6 lg:pt-0 lg:pl-8 space-y-5">
        <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--white-icon)] font-semibold">
          Key Details
        </h3>

        <div class="space-y-4 text-sm">
          <div>
            <span class="text-xs text-[var(--white-icon)] block font-mono">COLLEGE</span>
            <span class="text-[var(--white)] font-medium block mt-0.5">SRM Easwari Engineering College</span>
          </div>

          <div class="border-t border-[var(--card-border)] pt-3">
            <span class="text-xs text-[var(--white-icon)] block font-mono">DEGREE</span>
            <span class="text-[var(--white)] font-medium block mt-0.5">B.E. Computer Science and Design</span>
          </div>

          <div class="border-t border-[var(--card-border)] pt-3">
            <span class="text-xs text-[var(--white-icon)] block font-mono">DURATION</span>
            <span class="text-[var(--white)] font-medium block mt-0.5">2025 – 2029</span>
          </div>

          <div class="border-t border-[var(--card-border)] pt-3">
            <span class="text-xs text-[var(--white-icon)] block font-mono">LOCATION</span>
            <span class="text-[var(--white)] font-medium block mt-0.5">Chennai, Tamil Nadu, India</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
