---
// ProjectCard.astro
import SatQueryDiagram from './diagrams/SatQueryDiagram.astro';
import EchoGridDiagram from './diagrams/EchoGridDiagram.astro';

export interface Props {
  id: string;
  slug: string;
  index: string;
  category: string;
  title: string;
  status: string;
  statusType: 'in-progress' | 'proposal' | 'prototype';
  summary: string;
  topics: string[];
  repoUrl?: string;
  hasCaseStudy: boolean;
}

const { slug, index, category, title, status, statusType, summary, topics, repoUrl, hasCaseStudy } =
  Astro.props;
---

<div class="group flex flex-col">
  <!-- Diagram / thumbnail area -->
  <div class="rounded-2xl overflow-hidden mb-4 transition-transform duration-300 group-hover:scale-[1.02]">
    {slug === 'satquery-ai' && <SatQueryDiagram />}
    {slug === 'echogrid' && <EchoGridDiagram />}
  </div>

  <!-- Index + category -->
  <span class="text-xs font-mono tracking-wider text-[var(--white-icon)] mb-2">
    {index} · {category}
  </span>

  <!-- Title -->
  <h3 class="text-2xl font-semibold font-display text-[var(--white)] mb-2 group-hover:text-[var(--sec)] transition-colors">
    {title}
  </h3>

  <!-- Summary -->
  <p class="text-sm text-[var(--white-icon)] mb-4 leading-relaxed line-clamp-3">
    {summary}
  </p>

  <!-- Topic chips -->
  <div class="flex flex-wrap gap-2 mb-5" aria-label={`Technologies for ${title}`}>
    {
      topics.map((topic) => (
        <span class="px-2.5 py-1 rounded-full text-xs font-mono bg-[var(--pill-bg)] text-[var(--pill-text)] border border-[var(--pill-border)] font-medium">
          {topic}
        </span>
      ))
    }
  </div>

  <!-- Status badge + action buttons -->
  <div class="flex items-center gap-3 mt-auto">
    <!-- Status badge -->
    <span
      class:list={[
        'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-medium border',
        statusType === 'proposal'
          ? 'bg-[var(--accent-2)]/10 text-[var(--accent-2)] border-[var(--accent-2)]/30'
          : 'bg-[var(--sec)]/10 text-[var(--sec)] border-[var(--sec)]/30',
      ]}
    >
      {statusType === 'proposal' ? (
        <svg
          class="w-3 h-3 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
          <polyline points="14 2 14 8 20 8" />
        </svg>
      ) : (
        <span class="w-1.5 h-1.5 rounded-full bg-current" aria-hidden="true" />
      )}
      {status}
    </span>

    <!-- GitHub button (only if repo exists) -->
    {
      repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`GitHub repository for ${title}`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium text-[var(--white)] border border-[var(--btn-border)] bg-[var(--btn-bg)] rounded-xl hover:bg-[var(--btn-hover-bg)] hover:text-[var(--sec)] hover:border-[var(--sec)] transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)] shadow-sm"
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
          </svg>
          GitHub ↗
        </a>
      )
    }

    <!-- Case study link -->
    {
      hasCaseStudy && (
        <a
          href={`/projects/${slug}`}
          aria-label={`View ${title} case study`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium text-[var(--white)] border border-[var(--btn-border)] bg-[var(--btn-bg)] rounded-xl hover:bg-[var(--btn-hover-bg)] hover:text-[var(--sec)] hover:border-[var(--sec)] transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--sec)] shadow-sm"
        >
          Case Study →
        </a>
      )
    }
  </div>
</div>
