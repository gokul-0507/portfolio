---
// SatQueryDiagram.astro
// Custom 16:9 inline SVG diagram illustrating: Question -> Agent -> Imagery -> Answer
---

<div class="relative w-full aspect-[16/9] overflow-hidden rounded-item bg-surface/80 border border-border flex items-center justify-center p-2 sm:p-4 select-none">
  <svg
    viewBox="0 0 640 360"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full text-text"
    role="img"
    aria-label="SatQuery AI architecture workflow diagram showing flow of question, agent reasoning, satellite imagery retrieval, and analytical answer"
  >
    <!-- Background Grid -->
    <pattern id="sat-grid" width="32" height="32" patternUnits="userSpaceOnUse">
      <path
        d="M 32 0 L 0 0 0 32"
        fill="none"
        stroke="currentColor"
        stroke-opacity="0.05"
        stroke-width="1"
      />
    </pattern>
    <rect width="640" height="360" fill="url(#sat-grid)" />

    <!-- Connection Paths -->
    <!-- Path 1 to 2 -->
    <path
      d="M 145 180 L 195 180"
      stroke="var(--accent)"
      stroke-width="1.5"
      stroke-dasharray="4 4"
      stroke-linecap="round"
    />
    <polygon points="198,180 190,175 190,185" fill="var(--accent)" />

    <!-- Path 2 to 3 -->
    <path
      d="M 325 180 L 375 180"
      stroke="var(--accent)"
      stroke-width="1.5"
      stroke-dasharray="4 4"
      stroke-linecap="round"
    />
    <polygon points="378,180 370,175 370,185" fill="var(--accent)" />

    <!-- Path 3 to 4 -->
    <path
      d="M 505 180 L 535 180"
      stroke="var(--accent)"
      stroke-width="1.5"
      stroke-dasharray="4 4"
      stroke-linecap="round"
    />
    <polygon points="538,180 530,175 530,185" fill="var(--accent)" />

    <!-- Node 1: User Query -->
    <g transform="translate(30, 110)">
      <rect
        width="115"
        height="140"
        rx="8"
        fill="var(--surface)"
        stroke="var(--border)"
        stroke-width="1.5"
      />
      <!-- Terminal header -->
      <rect width="115" height="24" rx="8" fill="var(--border)" fill-opacity="0.4" />
      <circle cx="14" cy="12" r="3" fill="var(--muted)" />
      <circle cx="24" cy="12" r="3" fill="var(--muted)" />
      <text x="36" y="16" fill="var(--muted)" font-family="var(--font-mono)" font-size="9">
        QUERY
      </text>

      <!-- Terminal content -->
      <text x="12" y="48" fill="var(--muted)" font-family="var(--font-mono)" font-size="10">
        &gt; natural
      </text>
      <text x="12" y="64" fill="var(--muted)" font-family="var(--font-mono)" font-size="10">
        {' '}
        language
      </text>
      <text x="12" y="80" fill="var(--text)" font-family="var(--font-mono)" font-size="10">
        {' '}
        prompt
      </text>
      <rect x="12" y="94" width="85" height="4" rx="2" fill="var(--accent)" fill-opacity="0.3" />
      <rect x="12" y="104" width="55" height="4" rx="2" fill="var(--accent)" fill-opacity="0.2" />

      <!-- Pulse marker -->
      <circle cx="100" cy="12" r="3" fill="var(--accent)" />
    </g>

    <!-- Node 2: Reasoning Agent -->
    <g transform="translate(195, 100)">
      <rect
        width="130"
        height="160"
        rx="8"
        fill="var(--surface)"
        stroke="var(--accent)"
        stroke-width="1.5"
      />
      <rect width="130" height="24" rx="8" fill="var(--accent)" fill-opacity="0.12" />
      <text
        x="14"
        y="16"
        fill="var(--accent)"
        font-family="var(--font-mono)"
        font-size="9"
        font-weight="bold"
      >
        01 · REASONING
      </text>

      <!-- Agent internals -->
      <text
        x="14"
        y="48"
        fill="var(--text)"
        font-family="var(--font-mono)"
        font-size="11"
        font-weight="600"
      >
        Spatial Agent
      </text>

      <!-- Sub-steps -->
      <g transform="translate(12, 60)">
        <rect
          width="106"
          height="22"
          rx="4"
          fill="var(--surface-subtle)"
          stroke="var(--border)"
          stroke-width="1"
        />
        <text x="8" y="15" fill="var(--muted)" font-family="var(--font-mono)" font-size="8.5">
          Deconstruct Intent
        </text>
      </g>
      <g transform="translate(12, 88)">
        <rect
          width="106"
          height="22"
          rx="4"
          fill="var(--surface-subtle)"
          stroke="var(--border)"
          stroke-width="1"
        />
        <text x="8" y="15" fill="var(--muted)" font-family="var(--font-mono)" font-size="8.5">
          Tool / API Selection
        </text>
      </g>
      <g transform="translate(12, 116)">
        <rect
          width="106"
          height="22"
          rx="4"
          fill="var(--surface-subtle)"
          stroke="var(--border)"
          stroke-width="1"
        />
        <text x="8" y="15" fill="var(--accent)" font-family="var(--font-mono)" font-size="8.5">
          Coordinate Bounding
        </text>
      </g>
    </g>

    <!-- Node 3: Satellite Imagery -->
    <g transform="translate(375, 100)">
      <rect
        width="130"
        height="160"
        rx="8"
        fill="var(--surface)"
        stroke="var(--border)"
        stroke-width="1.5"
      />
      <rect width="130" height="24" rx="8" fill="var(--border)" fill-opacity="0.4" />
      <text x="14" y="16" fill="var(--muted)" font-family="var(--font-mono)" font-size="9">
        02 · EARTH FEED
      </text>

      <!-- Satellite Icon / Orbit Graphic -->
      <g transform="translate(65, 60)">
        <ellipse
          cx="0"
          cy="0"
          rx="42"
          ry="14"
          fill="none"
          stroke="var(--muted)"
          stroke-width="1"
          stroke-dasharray="3 3"
        />
        <!-- Satellite body -->
        <rect x="-8" y="-6" width="16" height="12" rx="2" fill="var(--accent)" />
        <line x1="-16" y1="0" x2="-8" y2="0" stroke="var(--accent)" stroke-width="2" />
        <line x1="8" y1="0" x2="16" y2="0" stroke="var(--accent)" stroke-width="2" />
        <rect x="-22" y="-5" width="6" height="10" fill="var(--text)" />
        <rect x="16" y="-5" width="6" height="10" fill="var(--text)" />
      </g>

      <!-- Spectral layers -->
      <text x="14" y="98" fill="var(--muted)" font-family="var(--font-mono)" font-size="9">
        Multispectral
      </text>
      <g transform="translate(12, 108)">
        <rect x="0" y="0" width="30" height="18" rx="3" fill="var(--accent)" fill-opacity="0.25" />
        <text x="6" y="13" fill="var(--accent)" font-family="var(--font-mono)" font-size="8">
          RGB
        </text>
        <rect
          x="36"
          y="0"
          width="30"
          height="18"
          rx="3"
          fill="var(--accent-2)"
          fill-opacity="0.25"
        />
        <text x="42" y="13" fill="var(--accent-2)" font-family="var(--font-mono)" font-size="8">
          NIR
        </text>
        <rect x="72" y="0" width="32" height="18" rx="3" fill="var(--border)" />
        <text x="76" y="13" fill="var(--muted)" font-family="var(--font-mono)" font-size="8">
          SWIR
        </text>
      </g>
      <text x="14" y="146" fill="var(--muted)" font-family="var(--font-mono)" font-size="8.5">
        Resolution: ~10m
      </text>
    </g>

    <!-- Node 4: Synthesized Answer -->
    <g transform="translate(535, 110)">
      <rect
        width="80"
        height="140"
        rx="8"
        fill="var(--surface)"
        stroke="var(--border)"
        stroke-width="1.5"
      />
      <rect width="80" height="24" rx="8" fill="var(--border)" fill-opacity="0.4" />
      <text x="10" y="16" fill="var(--muted)" font-family="var(--font-mono)" font-size="8.5">
        ANSWER
      </text>

      <g transform="translate(10, 36)">
        <!-- Synthesized visual representation -->
        <rect
          width="60"
          height="42"
          rx="4"
          fill="var(--surface-subtle)"
          stroke="var(--border)"
          stroke-width="1"
        />
        <!-- Detected zone highlight -->
        <circle
          cx="30"
          cy="21"
          r="10"
          fill="none"
          stroke="var(--accent)"
          stroke-width="1.5"
          stroke-dasharray="2 2"
        />
        <circle cx="30" cy="21" r="3" fill="var(--accent)" />
      </g>
      <text x="10" y="96" fill="var(--text)" font-family="var(--font-mono)" font-size="9">
        Grounded
      </text>
      <text x="10" y="110" fill="var(--accent)" font-family="var(--font-mono)" font-size="9">
        Synthesis
      </text>
      <rect x="10" y="122" width="60" height="3" rx="1.5" fill="var(--accent)" fill-opacity="0.4" />
    </g>
  </svg>
</div>
